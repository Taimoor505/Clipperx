# Use a lightweight Python base image
FROM python:3.12-slim

# Install system FFmpeg binary
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
# JS runtime that yt-dlp needs for YouTube links
COPY --from=denoland/deno:bin-2.5.6 /deno /usr/local/bin/deno

# Set working directory
WORKDIR /app

# Install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Link downloader, from the separate vidgrab project. Build with:
#   docker build --build-context vidgrab=vidgrab -f apps/api/Dockerfile.vercel -t clipperx-api apps/api
COPY --from=vidgrab . /opt/vidgrab
RUN pip install --no-cache-dir /opt/vidgrab

# YuNet face detector (OpenCV model zoo) for speaker-crop framing; checksum-pinned
RUN mkdir -p /opt/models && python -c "\
import hashlib, urllib.request; \
url = 'https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx'; \
data = urllib.request.urlopen(url, timeout=60).read(); \
assert hashlib.sha256(data).hexdigest() == '8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4', 'YuNet checksum mismatch'; \
open('/opt/models/face_detection_yunet_2023mar.onnx', 'wb').write(data)"

# Whisper models download here on first use; mount a volume to keep them between runs
ENV HF_HOME=/models

# Copy application source code
COPY . .

# Start the FastAPI server on default port 80
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "80"]
