# Copy to apps/api/.env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: force a specific Gemini model for every request
# GEMINI_MODEL=gemini-flash-latest

# Transcript engine: picks clips from a Whisper transcript with any OpenRouter model
OPENROUTER_API_KEY=
# Optional: default clip-picking model (any id from https://openrouter.ai/models)
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional: Whisper size (tiny, base, small, medium, large-v3). Bigger = slower, more accurate
# WHISPER_MODEL=small

# Optional: largest video the link importer will download, in MB
# MAX_DOWNLOAD_MB=4096
